function(fetch_network)
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/src/evaluate.h" HEADER)
    string(REGEX MATCH "nn-([a-f0-9]+)\\.nnue" NAME "${HEADER}")
    set(PREFIX "${CMAKE_MATCH_1}")
    string(LENGTH "${PREFIX}" PREFIX_LENGTH)
    if(NOT PREFIX_LENGTH EQUAL 12)
        message(FATAL_ERROR "The default NNUE filename must contain a 12-digit SHA-256 prefix.")
    endif()

    set(DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/${NAME}")
    set(LOCAL "${CMAKE_CURRENT_SOURCE_DIR}/src/${NAME}")
    if(EXISTS "${LOCAL}")
        file(SHA256 "${LOCAL}" HASH)
        string(SUBSTRING "${HASH}" 0 12 HASH_PREFIX)
        if(NOT HASH_PREFIX STREQUAL PREFIX)
            message(FATAL_ERROR "${LOCAL} has an invalid SHA-256 hash.")
        endif()
        file(COPY_FILE "${LOCAL}" "${DESTINATION}" ONLY_IF_DIFFERENT)
    elseif(EXISTS "${DESTINATION}")
        file(SHA256 "${DESTINATION}" HASH)
        string(SUBSTRING "${HASH}" 0 12 HASH_PREFIX)
        if(NOT HASH_PREFIX STREQUAL PREFIX)
            message(FATAL_ERROR "${DESTINATION} has an invalid SHA-256 hash.")
        endif()
    else()
        set(TEMPORARY "${DESTINATION}.download")
        foreach(BASE IN ITEMS "https://tests.stockfishchess.org/api/nn"
                              "https://raw.githubusercontent.com/official-stockfish/networks/master")
            message(STATUS "Downloading ${BASE}/${NAME}")
            file(DOWNLOAD "${BASE}/${NAME}" "${TEMPORARY}" STATUS STATUS
                 TIMEOUT 300 TLS_VERIFY ON)
            list(GET STATUS 0 CODE)
            if(CODE EQUAL 0)
                file(SHA256 "${TEMPORARY}" HASH)
                string(SUBSTRING "${HASH}" 0 12 HASH_PREFIX)
                if(HASH_PREFIX STREQUAL PREFIX)
                    file(RENAME "${TEMPORARY}" "${DESTINATION}")
                    break()
                endif()
                message(WARNING "Downloaded ${NAME} has an invalid SHA-256 hash.")
            else()
                list(GET STATUS 1 ERROR)
                message(WARNING "Could not download ${NAME}: ${ERROR}")
            endif()
            file(REMOVE "${TEMPORARY}")
        endforeach()
        if(NOT EXISTS "${DESTINATION}")
            message(FATAL_ERROR "Could not obtain ${NAME}. Place a valid copy in src/ and retry.")
        endif()
    endif()

    message(STATUS "Validated NNUE network: ${NAME}")
    set(NNUE_FILE "${DESTINATION}" PARENT_SCOPE)
endfunction()
